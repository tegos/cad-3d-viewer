{
    "name": "cad-3d-viewer",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Drag-drop STEP/IGES CAD files in the browser. Babylon.js + occt-import-js. No backend, no COOP/COEP.",
    "license": "MIT",
    "author": "Ivan Mykhavko",
    "homepage": "https://tegos.github.io/cad-3d-viewer/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tegos/cad-3d-viewer.git"
    },
    "bugs": {
        "url": "https://github.com/tegos/cad-3d-viewer/issues"
    },
    "keywords": [
        "cad",
        "step",
        "iges",
        "brep",
        "opencascade",
        "occt",
        "babylonjs",
        "webassembly",
        "3d-viewer",
        "browser"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@babylonjs/core": "^9.23.0",
        "@babylonjs/gui": "^9.23.0",
        "@babylonjs/loaders": "^9.23.0",
        "comlink": "^4.4.2",
        "occt-import-js": "0.0.23"
    },
    "devDependencies": {
        "@babylonjs/inspector": "^9.23.0",
        "@types/node": "^26.4.0",
        "typescript": "^7.0.2",
        "vite": "^5.4.10",
        "vite-plugin-static-copy": "^2.1.0"
    }
}
